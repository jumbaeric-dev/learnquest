APP_NAME=LearnQuest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

TRUSTED_PROXIES=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
LEARNQUEST_SUPPORT_EMAIL="support@yourdomain.com"
LEARNQUEST_TRIAL_REQUIRES_VERIFIED_EMAIL=false
LEARNQUEST_CHECKOUT_REQUIRES_VERIFIED_EMAIL=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nova AI Tutor
NOVA_AI_PROVIDER=gemini
NOVA_AI_FALLBACK_PROVIDERS=openrouter

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_WORKSPACE_ID=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=thinkingmachines/inkling-small:free

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Child login brute-force protection
LEARNQUEST_CHILD_LOGIN_MAX_ATTEMPTS=5
LEARNQUEST_CHILD_LOGIN_DECAY_SECONDS=60

# LearnQuest payment gateways
LEARNQUEST_DEFAULT_PAYMENT_PROVIDER=paystack
LEARNQUEST_PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# IntaSend is held in reserve while Paystack is integrated
LEARNQUEST_INTASEND_ENABLED=false
INTASEND_PUBLIC_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_SECRET=
INTASEND_WEBHOOK_CHALLENGE=
INTASEND_BASE_URL=https://api.intasend.com

LEARNQUEST_USD_PROVIDER=paypal
LEARNQUEST_PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
